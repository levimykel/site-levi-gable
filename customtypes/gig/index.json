{
  "format": "custom",
  "id": "gig",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "venue": {
        "config": {
          "label": "Venue"
        },
        "type": "Text"
      },
      "city": {
        "config": {
          "label": "City"
        },
        "type": "Text"
      },
      "date": {
        "config": {
          "label": "Date and time"
        },
        "type": "Timestamp"
      },
      "poster": {
        "config": {
          "label": "Poster"
        },
        "type": "Image"
      },
      "tickets": {
        "config": {
          "allowTargetBlank": true,
          "label": "Tickets / info",
          "select": "web"
        },
        "type": "Link"
      },
      "status": {
        "config": {
          "default_value": "upcoming",
          "label": "Status",
          "options": [
            "upcoming",
            "played",
            "cancelled (hangover)"
          ]
        },
        "type": "Select"
      },
      "notes": {
        "config": {
          "label": "Notes"
        },
        "type": "Text"
      },
      "setlist": {
        "config": {
          "label": "Set list",
          "multi": "em"
        },
        "type": "StructuredText"
      },
      "highlight": {
        "config": {
          "label": "Highlight of the night"
        },
        "type": "Text"
      },
      "photos": {
        "config": {
          "fields": {
            "image": {
              "config": {
                "label": "Photo"
              },
              "type": "Image"
            },
            "caption": {
              "config": {
                "label": "Caption"
              },
              "type": "Text"
            }
          },
          "label": "Photos"
        },
        "type": "Group"
      },
      "clips": {
        "config": {
          "fields": {
            "title": {
              "config": {
                "label": "Title"
              },
              "type": "Text"
            },
            "file": {
              "config": {
                "label": "Video file",
                "select": "media"
              },
              "type": "Link"
            },
            "embed": {
              "config": {
                "label": "Or embed (YouTube, Instagram…)"
              },
              "type": "Embed"
            }
          },
          "label": "Video clips"
        },
        "type": "Group"
      }
    }
  },
  "label": "Gig",
  "repeatable": true,
  "status": true
}